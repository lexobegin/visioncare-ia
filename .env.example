# ══════════════════════════════════════════════════════
# VisionCare AI — Servicio IA — Variables de entorno
# Copiar este archivo como ".env" y completar valores
# ══════════════════════════════════════════════════════

# ─── Aplicación ───
APP_NAME="VisionCare AI - Servicio IA"
NODE_ENV=development            # development | production
PORT=8000
API_PREFIX=api/v1

# ─── Base de datos PostgreSQL (LA MISMA del backend) ───
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=cambiar_por_tu_password
DB_DATABASE=visioncare_db
DB_SSL=false                    # true solo si el servidor exige SSL
DB_ECHO=true                    # muestra SQL en consola (solo dev)

# ─── JWT (DEBE SER EL MISMO del backend NestJS) ───
# Valida los tokens que emite el backend. COPIAR el valor
# exacto de JWT_SECRET del .env de visioncare-backend.
JWT_SECRET=REEMPLAZAR_CON_EL_MISMO_SECRET_DEL_BACKEND
JWT_ISSUER=visioncare-ai
JWT_ALGORITHM=HS256

# ─── API Key compartida (NestJS ↔ IA, server-to-server) ───
# Si se define, TODAS las rutas (excepto /health) exigen el
# header:  X-API-Key: <valor>
# Si queda vacía → sin autenticación (SOLO desarrollo local)
IA_API_KEY=

# ─── Modelo YOLO ───
YOLO_MODEL=yolov8n.pt           # nano: el más rápido (ideal CPU)
YOLO_CONFIDENCE=0.5             # umbral mínimo de confianza (0-1)
YOLO_DEVICE=cpu                 # cpu | cuda (si hay GPU NVIDIA)
YOLO_IMGSZ=640                  # resolución de análisis del modelo

# ─── Límites de imágenes ───
MAX_IMAGE_SIZE_MB=10            # mismo límite que el backend

# ─── CORS (para pruebas directas desde Swagger del navegador) ───
CORS_ORIGINS=http://localhost:5173,http://localhost:3000